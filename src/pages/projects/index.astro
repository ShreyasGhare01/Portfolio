---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ProjectWeb from '../../components/ProjectWeb.astro';
import { projects, categories, type Category } from '../../data/projects';

const order: Category[] = ['college', 'research', 'personal'];
const groups = order
  .map((key) => ({ key, ...categories[key], items: projects.filter((p) => p.category === key) }))
  .filter((g) => g.items.length > 0);
---

<Base title="Projects" description="Engineering, research, and personal projects by Shreyas Ghare.">
  <section class="page-head">
    <div class="wrap">
      <h1>Projects</h1>
      <nav class="jump" aria-label="Project categories">
        {groups.map((g) => <a href={`#${g.key}`}>{g.name}</a>)}
      </nav>
      <ProjectWeb />
    </div>
  </section>

  <div id="project-list"></div>
  {
    groups.map((g) => (
      <section class="section" id={g.key}>
        <div class="wrap">
          <h2 class="group__title">{g.name}</h2>
          <p class="group__blurb">{g.blurb}</p>
          <div class="cards">
            {g.items.map((p) => <ProjectCard project={p} />)}
          </div>
        </div>
      </section>
    ))
  }
</Base>

<style>
  .page-head {
    padding: clamp(48px, 8vw, 96px) 0 0;
  }
  .page-head h1 {
    font-size: var(--step-4);
    font-weight: 800;
    text-transform: uppercase;
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }
  .jump a {
    border: 1px solid var(--ink);
    border-radius: 999px;
    padding: 6px 16px;
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .jump a:hover {
    background: var(--mint);
  }
  .group__title {
    font-size: var(--step-2);
    font-weight: 800;
    text-transform: uppercase;
  }
  .group__blurb {
    color: var(--muted);
    margin: 8px 0 28px;
    max-width: 60ch;
  }
</style>
