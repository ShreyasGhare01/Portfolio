---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { projects, categories, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

interface Props {
  project: Project;
  prev: Project;
  next: Project;
}
const { project, prev, next } = Astro.props;
const category = categories[project.category];
---

<Base title={project.title} description={project.summary}>
  <article class="project">
    <div class="wrap">
      <a class="back" href="/projects/"><Icon name="back" /> Back to projects</a>

      <p class="project__kicker">{category.name} · {project.dates}</p>
      <h1 class="project__title">{project.title}</h1>

      <div class="project__grid">
        <dl class="facts">
          <div>
            <dt>Years</dt>
            <dd>{project.dates}</dd>
          </div>
          {
            project.facts.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
        </dl>

        <div class="project__body">
          <ul class="chips project__tags" aria-label="Skills">
            {project.tags.map((t) => <li>{t}</li>)}
          </ul>
          {project.description.map((p) => <p>{p}</p>)}

          {
            project.links && (
              <div class="btn-row">
                {project.links.map((l) => (
                  <a class="btn" href={l.href} target="_blank" rel="noopener noreferrer">
                    {l.label} <Icon name="arrow" />
                  </a>
                ))}
              </div>
            )
          }

          {
            project.acknowledgment && (
              <p class="project__ack">
                <span class="project__ack-label">Acknowledgments</span>
                {project.acknowledgment}
              </p>
            )
          }
        </div>
      </div>

      {
        project.pipeline && (
          <section class="pipeline" aria-label={project.pipeline.title}>
            <h2 class="block-title">{project.pipeline.title}</h2>
            <ol class="pipeline__steps">
              {project.pipeline.steps.map((s, i) => (
                <li class="pipeline__step">
                  <span class="pipeline__num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="pipeline__label">{s.label}</span>
                  {s.detail && <span class="pipeline__detail">{s.detail}</span>}
                </li>
              ))}
            </ol>
          </section>
        )
      }

      {
        project.images && (
          <section class="gallery-wrap" aria-label="Figures">
            <h2 class="block-title">Figures</h2>
            <div class="gallery">
              {project.images.map((img, i) => (
                <figure class:list={['gallery__item', { 'gallery__item--wide': img.wide }]}>
                  {img.video ? (
                    <video
                      class="gallery__video"
                      src={img.video}
                      poster={img.src}
                      width={img.width}
                      height={img.height}
                      aria-label={img.alt}
                      autoplay
                      muted
                      loop
                      playsinline
                      controls
                      preload="metadata"
                    />
                  ) : (
                    <button class="gallery__open" type="button" data-index={i} aria-label={`Enlarge: ${img.alt}`}>
                      <img src={img.src} alt={img.alt} width={img.width} height={img.height} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                    </button>
                  )}
                  {img.caption && (
                    <figcaption>
                      <span class="gallery__fig">Fig. {i + 1}</span> {img.caption}
                    </figcaption>
                  )}
                </figure>
              ))}
            </div>

            <dialog class="lightbox" aria-label="Enlarged figure">
              <button class="lightbox__close" type="button" aria-label="Close"><Icon name="close" /></button>
              <img class="lightbox__img" src="" alt="" />
              <p class="lightbox__cap"></p>
            </dialog>
          </section>
        )
      }

      <nav class="pager" aria-label="More projects">
        <a href={`/projects/${prev.slug}/`}>
          <span class="pager__label">Previous</span>
          <span class="pager__title">{prev.title}</span>
        </a>
        <a href={`/projects/${next.slug}/`} class="pager__next">
          <span class="pager__label">Next</span>
          <span class="pager__title">{next.title}</span>
        </a>
      </nav>
    </div>
  </article>
</Base>

<style>
  .project {
    padding: clamp(32px, 6vw, 72px) 0 clamp(56px, 8vw, 104px);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--step--1);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
  }
  .back :global(svg) {
    width: 16px;
    height: 16px;
  }
  .project__kicker {
    margin: 40px 0 8px;
    color: var(--muted);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .project__title {
    font-size: var(--step-3);
    font-weight: 800;
    max-width: 24ch;
  }
  .project__grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(24px, 4vw, 64px);
    margin-top: 40px;
  }
  .facts {
    margin: 0;
    background: var(--mint);
    border: 1px solid var(--ink);
    padding: 14px;
    align-self: start;
  }
  .facts div {
    background: var(--paper);
    border: 1px solid var(--ink);
    padding: 12px 14px;
  }
  .facts div + div {
    border-top: 0;
  }
  .facts dt {
    font-size: var(--step--1);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .facts dd {
    margin: 2px 0 0;
    font-size: var(--step--1);
  }
  .project__body {
    max-width: 64ch;
  }
  .project__tags {
    margin: 0 0 20px;
  }
  .project__body .btn-row {
    margin-top: 8px;
  }
  .project__ack {
    margin: 28px 0 0;
    padding-top: 16px;
    border-top: 1px dashed #c9c9c6;
    font-size: var(--step--1);
    color: var(--muted);
    line-height: 1.6;
  }
  .project__ack-label {
    display: block;
    font-weight: 800;
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 11.5px;
    margin-bottom: 4px;
  }
  .block-title {
    font-size: var(--step-1);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 20px;
  }

  /* Signal chain / pipeline diagram */
  .pipeline {
    margin-top: 64px;
  }
  .pipeline__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px 26px;
  }
  .pipeline__step {
    position: relative;
    border: 1px solid var(--ink);
    background: var(--paper);
    padding: 12px 14px 14px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .pipeline__step:nth-child(odd) {
    background: var(--mint-soft);
  }
  /* arrow connecting each step to the next */
  .pipeline__step:nth-child(4n)::after,
  .pipeline__step:nth-child(4n)::before {
    display: none;
  }
  .pipeline__step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 50%;
    right: -21px;
    width: 16px;
    height: 1px;
    background: var(--ink);
  }
  .pipeline__step:not(:last-child)::before {
    content: '';
    position: absolute;
    top: calc(50% - 4px);
    right: -22px;
    border: 4.5px solid transparent;
    border-left: 6px solid var(--ink);
    border-right: 0;
  }
  .pipeline__num {
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.06em;
  }
  .pipeline__label {
    font-weight: 800;
    font-size: var(--step--1);
    line-height: 1.3;
  }
  .pipeline__detail {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.4;
  }

  /* Figures */
  .gallery-wrap {
    margin-top: 64px;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 24px;
    align-items: start;
  }
  .gallery__item {
    margin: 0;
  }
  /* Videos: silent, looping clips; tall phone videos are capped in height */
  .gallery__video {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 640px;
    height: auto;
    border: 1px solid var(--ink);
    background: var(--ink);
  }
  .gallery__item--wide {
    grid-column: 1 / -1;
  }
  .gallery__open {
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--ink);
    background: var(--paper);
    cursor: zoom-in;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .gallery__open:hover {
    transform: translate(-3px, -3px);
    box-shadow: 5px 5px 0 var(--ink);
  }
  .gallery__open img {
    width: 100%;
    height: auto;
  }
  /* wide figures never upscale past their real resolution */
  .gallery__item--wide .gallery__open {
    width: auto;
    max-width: 100%;
    display: inline-block;
  }
  .gallery__item--wide .gallery__open img {
    width: auto;
    max-width: 100%;
    max-height: 640px;
  }
  .gallery figcaption {
    font-size: var(--step--1);
    color: var(--muted);
    margin-top: 10px;
    line-height: 1.55;
    max-width: 80ch;
  }
  .gallery__fig {
    font-weight: 800;
    color: var(--ink);
  }

  /* Lightbox */
  .lightbox {
    border: 1px solid var(--ink);
    padding: 16px;
    max-width: min(1400px, 94vw);
    max-height: 94vh;
    background: var(--paper);
  }
  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.72);
  }
  .lightbox__img {
    max-width: 100%;
    max-height: calc(94vh - 120px);
    margin: 0 auto;
  }
  .lightbox__cap {
    font-size: var(--step--1);
    color: var(--muted);
    margin: 12px 0 0;
    max-width: 90ch;
  }
  .lightbox__close {
    position: absolute;
    top: 8px;
    right: 8px;
    background: var(--paper);
    border: 1px solid var(--ink);
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .lightbox__close :global(svg) {
    width: 18px;
    height: 18px;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 72px;
    border-top: 1px solid var(--ink);
    padding-top: 24px;
  }
  .pager a {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .pager__next {
    text-align: right;
  }
  .pager__label {
    font-size: var(--step--1);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .pager__title {
    font-weight: 800;
  }
  .pager a:hover .pager__title {
    text-decoration: underline;
  }
  @media (max-width: 760px) {
    .project__grid {
      grid-template-columns: 1fr;
    }
    .gallery {
      grid-template-columns: 1fr;
    }
    .pipeline__steps {
      grid-template-columns: 1fr;
      gap: 22px;
    }
    .pipeline__step:nth-child(4n):not(:last-child)::after,
    .pipeline__step:nth-child(4n):not(:last-child)::before {
      display: block;
    }
    /* arrows point down when steps stack */
    .pipeline__step:not(:last-child)::after {
      top: auto;
      bottom: -17px;
      right: auto;
      left: 24px;
      width: 1px;
      height: 12px;
    }
    .pipeline__step:not(:last-child)::before {
      top: auto;
      bottom: -21px;
      right: auto;
      left: 19.5px;
      border: 5px solid transparent;
      border-top: 6px solid var(--ink);
      border-bottom: 0;
    }
    .pager {
      grid-template-columns: 1fr;
    }
    .pager__next {
      text-align: left;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  if (dialog) {
    const img = dialog.querySelector<HTMLImageElement>('.lightbox__img')!;
    const cap = dialog.querySelector<HTMLElement>('.lightbox__cap')!;
    document.querySelectorAll<HTMLButtonElement>('.gallery__open').forEach((btn) => {
      btn.addEventListener('click', () => {
        const src = btn.querySelector('img')!;
        img.src = src.currentSrc || src.src;
        img.alt = src.alt;
        cap.textContent = btn.closest('figure')?.querySelector('figcaption')?.textContent?.trim() ?? '';
        dialog.showModal();
      });
    });
    dialog.querySelector('.lightbox__close')!.addEventListener('click', () => dialog.close());
    // click outside the image closes it
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>
