---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { projects, categories, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

interface Props {
  project: Project;
  prev: Project;
  next: Project;
}
const { project, prev, next } = Astro.props;
const category = categories[project.category];
---

<Base title={project.title} description={project.summary}>
  <article class="project">
    <div class="wrap">
      <a class="back" href="/projects/"><Icon name="back" /> Back to projects</a>

      <p class="project__kicker">{category.name} · {project.dates}</p>
      <h1 class="project__title">{project.title}</h1>

      <div class="project__grid">
        <dl class="facts">
          <div>
            <dt>Years</dt>
            <dd>{project.dates}</dd>
          </div>
          {
            project.facts.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
        </dl>

        <div class="project__body">
          {project.description.map((p) => <p>{p}</p>)}

          {
            project.links && (
              <div class="btn-row">
                {project.links.map((l) => (
                  <a class="btn" href={l.href} rel="noopener">
                    {l.label} <Icon name="arrow" />
                  </a>
                ))}
              </div>
            )
          }

          {
            project.images && (
              <div class="gallery">
                {project.images.map((img) => (
                  <img src={img.src} alt={img.alt} loading="lazy" />
                ))}
              </div>
            )
          }
        </div>
      </div>

      <nav class="pager" aria-label="More projects">
        <a href={`/projects/${prev.slug}/`}>
          <span class="pager__label">Previous</span>
          <span class="pager__title">{prev.title}</span>
        </a>
        <a href={`/projects/${next.slug}/`} class="pager__next">
          <span class="pager__label">Next</span>
          <span class="pager__title">{next.title}</span>
        </a>
      </nav>
    </div>
  </article>
</Base>

<style>
  .project {
    padding: clamp(32px, 6vw, 72px) 0 clamp(56px, 8vw, 104px);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--step--1);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
  }
  .back :global(svg) {
    width: 16px;
    height: 16px;
  }
  .project__kicker {
    margin: 40px 0 8px;
    color: var(--muted);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .project__title {
    font-size: var(--step-3);
    font-weight: 800;
    max-width: 24ch;
  }
  .project__grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(24px, 4vw, 64px);
    margin-top: 40px;
  }
  .facts {
    margin: 0;
    background: var(--mint);
    border: 1px solid var(--ink);
    padding: 14px;
    align-self: start;
  }
  .facts div {
    background: var(--paper);
    border: 1px solid var(--ink);
    padding: 12px 14px;
  }
  .facts div + div {
    border-top: 0;
  }
  .facts dt {
    font-size: var(--step--1);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .facts dd {
    margin: 2px 0 0;
    font-size: var(--step--1);
  }
  .project__body {
    max-width: 64ch;
  }
  .project__body .btn-row {
    margin-top: 8px;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
    margin-top: 32px;
  }
  .gallery img {
    border: 1px solid var(--ink);
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 72px;
    border-top: 1px solid var(--ink);
    padding-top: 24px;
  }
  .pager a {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .pager__next {
    text-align: right;
  }
  .pager__label {
    font-size: var(--step--1);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .pager__title {
    font-weight: 800;
  }
  .pager a:hover .pager__title {
    text-decoration: underline;
  }
  @media (max-width: 760px) {
    .project__grid {
      grid-template-columns: 1fr;
    }
    .pager {
      grid-template-columns: 1fr;
    }
    .pager__next {
      text-align: left;
    }
  }
</style>
